<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files, parameter configs, and RViz configuration for the AMR stack
    (C++/ROS 2 port). Provides slam.launch.py, nav.launch.py, demo.launch.py,
    and a launch_testing integration test that mirrors the Python 'amr demo' DEMO PASS.
  </description>
  <maintainer email="kangjmo91@gmail.com">Kang Jung Mo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- runtime: all AMR nodes -->
  <exec_depend>amr_sim</exec_depend>
  <exec_depend>amr_mapping</exec_depend>
  <exec_depend>amr_localization</exec_depend>
  <exec_depend>amr_slam</exec_depend>
  <exec_depend>amr_navigation</exec_depend>
  <exec_depend>amr_interfaces</exec_depend>

  <!-- visualization -->
  <exec_depend>rviz2</exec_depend>

  <!-- launch infrastructure -->
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- testing -->
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
